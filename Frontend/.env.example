# Frontend Configuration
# Copy this file to .env.local and fill in your actual values
# VITE_ prefixed variables are exposed to client-side code

# API Configuration
VITE_API_URL=http://localhost:5000/api

# PositionStack API (Geolocation)
VITE_POSITIONSTACK_API_KEY=your_positionstack_key_here

# Razorpay (Payment)
# These are public keys, safe to expose
VITE_RAZORPAY_KEY_ID=your_razorpay_public_key

# Cloudinary (Image Display)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_name

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_DEBUG=false

