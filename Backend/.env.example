# Copy to .env and fill values before running in production
# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/vks?retryWrites=true&w=majority

# JWT secret used to sign auth tokens (required)
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRE=7d

# Razorpay credentials (for online payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_SECRET=your_razorpay_secret

# Cloudinary (for uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Host/port
HOST=127.0.0.1
PORT=5000
# Backend Configuration
# Copy this file to .env and fill in your actual values

# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/vks

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# Bcrypt
BCRYPT_ROUNDS=10

# Cloudinary (Image Storage)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=vks

# Razorpay (Payment)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_SECRET=your_razorpay_secret

# Email Configuration (for notifications)
SMTP_SERVICE=gmail
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# PositionStack (Geolocation)
POSITIONSTACK_API_KEY=your_positionstack_api_key

# Environment specific
DEBUG=false
LOG_LEVEL=info
